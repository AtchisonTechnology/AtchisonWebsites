<%# Files attached to a lesson. Rendered between the video and the reading on a
    video_reading lesson (the file is usually needed while watching, not after),
    and at the foot of the body on every other content type. Renders nothing when
    the lesson has no downloads. %>
<% if (lesson.downloads || []).any? %>
  <section class="lesson-downloads" aria-labelledby="lesson-downloads-heading">
    <h2 id="lesson-downloads-heading" class="lesson-downloads-heading">Files for this lesson</h2>
    <ul class="download-list">
      <% lesson.downloads.each do |d| %>
        <li class="download-card">
          <a href="<%= relative_url d.file %>" class="download-title" download><%= d.title %></a>
          <% if d.note %>
            <p class="download-note"><%= d.note %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
