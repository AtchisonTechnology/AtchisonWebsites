---
permalink: /sitemap.xml
sitemap_exclude: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% site.collections.each do |_label, collection| %>
  <% collection.resources.each do |resource| %>
    <% next if resource.data.sitemap_exclude %>
    <% next if resource.absolute_url.to_s.empty? %>
    <url>
      <loc><%= resource.absolute_url %></loc>
      <% if resource.data.date %>
      <lastmod><%= resource.data.date.strftime("%Y-%m-%d") %></lastmod>
      <% end %>
    </url>
  <% end %>
<% end %>
</urlset>
