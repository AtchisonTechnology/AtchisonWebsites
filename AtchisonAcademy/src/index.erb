---
layout: default
page_class: homepage
title: Home
---

<%
  # The collections already hold only this site's items — the SharedContent
  # builder drops everything without show_academy at read time.
  academy_books            = site.collections["books"].resources.sort_by { |b| b.data.order_academy || 99 }
  academy_books_featured   = academy_books.select { |b| b.data.feature_academy }
  academy_books_other      = academy_books.reject { |b| b.data.feature_academy }

  academy_courses          = site.collections["courses"].resources.sort_by { |c| c.data.order_academy || 99 }
  academy_courses_featured = academy_courses.select { |c| c.data.feature_academy }
  academy_courses_other    = academy_courses.reject { |c| c.data.feature_academy }
%>

<section class="academy-hero">
  <div class="academy-hero-inner">
    <div class="academy-hero-logo">
      <img src="<%= relative_url '/images/logo-academy.png' %>" alt="Atchison Academy" />
    </div>
    <h1>Atchison Academy</h1>
    <p>Exclusive books, courses, and training directly from Lee Atchison &mdash; for software architects and technology leaders who want to build, scale, and lead with confidence.</p>
  </div>
</section>

<% unless academy_books.empty? %>
<section class="academy-section">
  <div class="section-inner">
    <div class="section-header">
      <span class="section-label">Books</span>
      <h2 class="section-title">Books at Atchison Academy</h2>
      <p>Published works available through Atchison Academy.</p>
    </div>
    <div class="books-grid">
      <% academy_books_featured.each do |book| %>
        <article class="book-card">
          <div class="book-cover-wrap">
            <img src="<%= relative_url book.data.cover_image %>"
                 alt="<%= book.data.title %> book cover" class="book-cover" />
          </div>
          <div class="book-card-body">
            <% if book.data.badge %>
              <span class="book-tag book-tag--<%= book.data.badge_style %>"><%= book.data.badge %></span>
            <% end %>
            <h3><%= book.data.title %></h3>
            <p class="book-authors"><%= book.data.authors&.join(", ") %></p>
            <p><%= book.data.summary %></p>
            <a href="<%= relative_url book.relative_url %>" class="book-link">Learn more &rarr;</a>
          </div>
        </article>
      <% end %>
      <% academy_books_other.each do |book| %>
        <article class="book-card book-card--secondary">
          <div class="book-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="book-card-body">
            <% if book.data.badge %>
              <span class="book-tag book-tag--<%= book.data.badge_style %>"><%= book.data.badge %></span>
            <% end %>
            <h3><%= book.data.title %></h3>
            <p class="book-authors"><%= book.data.authors&.join(", ") %></p>
            <p><%= book.data.summary %></p>
            <a href="<%= relative_url book.relative_url %>" class="book-link">Learn more &rarr;</a>
          </div>
        </article>
      <% end %>
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a href="<%= relative_url '/books' %>" class="btn btn-outline">View All Books &rarr;</a>
    </div>
  </div>
</section>
<% end %>

<% unless academy_courses.empty? %>
<section class="academy-section academy-section--alt">
  <div class="section-inner">
    <div class="section-header">
      <span class="section-label">Courses</span>
      <h2 class="section-title">Courses at Atchison Academy</h2>
      <p>Training available through Atchison Academy and affiliated learning platforms.</p>
    </div>
    <div class="courses-grid">
      <% academy_courses_featured.each do |course| %>
        <a href="<%= relative_url course.relative_url %>" class="course-card course-card--featured">
          <span class="course-card-platform"><%= course.data.platform %></span>
          <h3><%= course.data.title %></h3>
          <p><%= course.data.summary %></p>
          <span class="course-card-link">Learn more &rarr;</span>
        </a>
      <% end %>
      <% academy_courses_other.each do |course| %>
        <a href="<%= relative_url course.relative_url %>" class="course-card">
          <span class="course-card-platform"><%= course.data.platform %></span>
          <h3><%= course.data.title %></h3>
          <p><%= course.data.summary %></p>
          <span class="course-card-link">Learn more &rarr;</span>
        </a>
      <% end %>
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a href="<%= relative_url '/courses' %>" class="btn btn-outline">View All Courses &rarr;</a>
    </div>
  </div>
</section>
<% end %>

<section class="academy-cta">
  <div class="academy-cta-inner">
    <div class="academy-cta-logo">
      <img src="<%= relative_url '/images/logo-academy.png' %>" alt="Atchison Academy" />
    </div>
    <div>
      <span class="section-label">Premium Training</span>
      <h2 class="section-title" style="color:#ffffff;">Start Learning Today</h2>
    </div>
  </div>
</section>
