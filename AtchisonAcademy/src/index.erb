---
layout: default
page_class: homepage
title: Home
---

<%
  # The collections already hold only this site's items — the SharedContent
  # builder drops everything without show_academy at read time.
  academy_books            = site.collections["books"].resources.sort_by { |b| b.data.order_academy || 99 }
  academy_books_featured   = academy_books.select { |b| b.data.feature_academy }
  academy_books_other      = academy_books.reject { |b| b.data.feature_academy }

  academy_courses          = site.collections["courses"].resources.sort_by { |c| c.data.order_academy || 99 }
  academy_courses_featured = academy_courses.select { |c| c.data.feature_academy }
  academy_courses_other    = academy_courses.reject { |c| c.data.feature_academy }

  # Spec0031 §B6. Each new section shows only once what it points to is
  # public, so this page is safe to merge before launch: a hidden course or
  # page has already been dropped from the build (shared_content.rb), so it
  # can't be found here in production, while dev and deploy previews see it.
  #
  # The featured course is the visible course carrying `spotlight_academy`;
  # its content comes from its sales data file.
  featured_course = academy_courses.find { |c| c.data.spotlight_academy }
  featured_sales  = featured_course && sales_data_for(featured_course)
  worksheet_page  = site.resources.find { |r| r.relative_url == "/free/cost-attribution-worksheet/" }
%>

<section class="academy-hero">
  <div class="academy-hero-inner">
    <div class="academy-hero-logo">
      <img src="<%= relative_url '/images/logo-academy.png' %>" alt="Atchison Academy" />
    </div>
    <h1>Architecture courses from someone who's run it at scale.</h1>
    <p>Practical, self-paced courses for software architects and engineering leaders, from Lee Atchison.</p>
  </div>
</section>

<%# Copy for the hero and the sections below: Sales Page Copy.md §4,
    approved by Lee 2026-10-02. The featured course's title and line come
    from its sales data file. %>
<% if featured_course %>
<section class="home-featured">
  <div class="home-featured-inner">
    <div>
      <p class="sales-eyebrow">New course</p>
      <h2><%= featured_course.data.title %></h2>
      <% if featured_sales %>
        <p class="home-featured-hook"><%= featured_sales.hook %> <%= featured_sales.pitch %></p>
      <% else %>
        <p class="home-featured-hook"><%= featured_course.data.summary %></p>
      <% end %>
      <a href="<%= relative_url featured_course.relative_url %>" class="btn btn-deep">See the course &rarr;</a>
    </div>
    <div>
      <% if featured_sales %>
        <%= render "sales/trailer", page: selling_page(featured_course) %>
      <% elsif featured_course.data.cover_image %>
        <img src="<%= relative_url featured_course.data.cover_image %>" alt="<%= featured_course.data.title %> course image" class="sales-hero-image" />
      <% end %>
    </div>
  </div>
</section>

<section class="home-band">
  <div class="home-band-inner">
    <h2>How the courses work</h2>
    <ul class="home-how">
      <li><strong>Short video lessons.</strong> Each one makes one argument, with a reading you can come back to.</li>
      <li><strong>Tools you keep.</strong> Worksheets and templates you use on your own systems, not just during the course.</li>
      <li><strong>Your own pace.</strong> Start when you want, and stop when the meeting runs long.</li>
    </ul>
  </div>
</section>
<% end %>

<% if worksheet_page %>
<section class="home-band home-band--white">
  <div class="home-band-inner">
    <h2>How much of your cloud bill can you explain?</h2>
    <p>The Cost Attribution Worksheet takes your five biggest line items and asks what decision caused each one. Most teams find out it's fewer than they thought.</p>
    <a href="<%= relative_url worksheet_page.relative_url %>" class="btn btn-deep-outline">Get the free worksheet &rarr;</a>
  </div>
</section>
<% end %>

<section class="home-band">
  <div class="home-band-inner sales-about">
    <img src="<%= relative_url '/images/lee-casual-vertical.jpeg' %>" width="640" height="962" alt="Lee Atchison" class="sales-about-photo" />
    <div>
      <h2>About Lee</h2>
      <p>Lee Atchison spent seven years at Amazon and AWS and eight at New Relic, building and running systems at scale. He's the author of <em>Architecting for Scale</em> (O&rsquo;Reilly), and he writes the Software Architecture Insights newsletter.</p>
    </div>
  </div>
</section>

<% unless academy_books.empty? %>
<section class="academy-section">
  <div class="section-inner">
    <div class="section-header">
      <span class="section-label">Books</span>
      <h2 class="section-title">Books at Atchison Academy</h2>
      <p>Published works available through Atchison Academy.</p>
    </div>
    <div class="books-grid">
      <% academy_books_featured.each do |book| %>
        <article class="book-card">
          <div class="book-cover-wrap">
            <img src="<%= relative_url book.data.cover_image %>"
                 alt="<%= book.data.title %> book cover" class="book-cover" />
          </div>
          <div class="book-card-body">
            <% if book.data.badge %>
              <span class="book-tag book-tag--<%= book.data.badge_style %>"><%= book.data.badge %></span>
            <% end %>
            <h3><%= book.data.title %></h3>
            <p class="book-authors"><%= book.data.authors&.join(", ") %></p>
            <p><%= book.data.summary %></p>
            <a href="<%= relative_url book.relative_url %>" class="book-link">Learn more &rarr;</a>
          </div>
        </article>
      <% end %>
      <% academy_books_other.each do |book| %>
        <article class="book-card book-card--secondary">
          <div class="book-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="book-card-body">
            <% if book.data.badge %>
              <span class="book-tag book-tag--<%= book.data.badge_style %>"><%= book.data.badge %></span>
            <% end %>
            <h3><%= book.data.title %></h3>
            <p class="book-authors"><%= book.data.authors&.join(", ") %></p>
            <p><%= book.data.summary %></p>
            <a href="<%= relative_url book.relative_url %>" class="book-link">Learn more &rarr;</a>
          </div>
        </article>
      <% end %>
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a href="<%= relative_url '/books' %>" class="btn btn-outline btn-outline--dark">View All Books &rarr;</a>
    </div>
  </div>
</section>
<% end %>

<% unless academy_courses.empty? %>
<section class="academy-section academy-section--alt">
  <div class="section-inner">
    <div class="section-header">
      <span class="section-label">Courses</span>
      <h2 class="section-title">Courses at Atchison Academy</h2>
      <p>Training available through Atchison Academy and affiliated learning platforms.</p>
    </div>
    <div class="courses-grid">
      <% academy_courses_featured.each do |course| %>
        <a href="<%= relative_url course.relative_url %>" class="course-card course-card--featured">
          <% if course.data.cover_image %>
            <div class="course-cover-wrap">
              <img src="<%= relative_url course.data.cover_image %>"
                   alt="<%= course.data.title %> course image" class="course-cover" />
            </div>
          <% end %>
          <% if course.data.availability == "prelaunch" %>
            <span class="course-card-platform course-platform-badge--prelaunch">Coming Soon</span>
          <% else %>
            <span class="course-card-platform"><%= course.data.platform %></span>
          <% end %>
          <h3><%= course.data.title %></h3>
          <p><%= course.data.summary %></p>
          <span class="course-card-link">Learn more &rarr;</span>
        </a>
      <% end %>
      <% academy_courses_other.each do |course| %>
        <a href="<%= relative_url course.relative_url %>" class="course-card">
          <% if course.data.availability == "prelaunch" %>
            <span class="course-card-platform course-platform-badge--prelaunch">Coming Soon</span>
          <% else %>
            <span class="course-card-platform"><%= course.data.platform %></span>
          <% end %>
          <h3><%= course.data.title %></h3>
          <p><%= course.data.summary %></p>
          <span class="course-card-link">Learn more &rarr;</span>
        </a>
      <% end %>
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a href="<%= relative_url '/courses' %>" class="btn btn-outline btn-outline--dark">View All Courses &rarr;</a>
    </div>
  </div>
</section>
<% end %>

<%# Newsletter signup: the Software Architecture Insights inline Kit form
    (uid from SoftwareArchitectureInsights/src/_data/site_metadata.yml). The
    form's own button label is set in Kit. %>
<section class="home-band home-newsletter">
  <div class="home-band-inner">
    <h2>Software Architecture Insights</h2>
    <p>A weekly newsletter on building and running systems that scale.</p>
    <script async data-uid="c448363077" src="https://softwarearchitectureinsights.kit.com/c448363077/index.js"></script>
  </div>
</section>
