---
layout: none
permalink: /sitemap.xml
sitemap_exclude: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<%
  sitemap_resources = site.resources
    .select  { |r| r.relative_url.end_with?("/") }
    .reject  { |r| r.data.sitemap_exclude || r.data.published == false }
    .sort_by { |r| r.relative_url }
%>
<% sitemap_resources.each do |resource| %>
  <url>
    <loc><%= site.config.url %><%= resource.relative_url %></loc>
<% if resource.data.date %>
    <lastmod><%= resource.data.date.strftime("%Y-%m-%d") %></lastmod>
<% end %>
  </url>
<% end %>
</urlset>
