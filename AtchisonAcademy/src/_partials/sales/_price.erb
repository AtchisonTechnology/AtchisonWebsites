<% price = page.sales.price_section %>
<section class="sales-section sales-price-section" id="price">
  <div class="sales-inner">
    <h2><%= price&.heading || page.sales.title %></h2>
    <%= render "sales/buy", page: page, content: "price", detail: price&.summary %>
    <% if price&.refund %>
      <p class="sales-refund"><%= sales_text price.refund, page.sales %></p>
    <% end %>
    <% if price&.note %>
      <p class="sales-price-note"><%= sales_text price.note, page.sales %></p>
    <% end %>
    <%# 5-seat pack: main sales page only. Every offer page hides it. %>
    <% team = page.sales.team_pack %>
    <% if team && !page.offer? %>
      <div class="sales-team-pack">
        <p class="sales-team-line"><%= sales_text team.line, page.sales %></p>
        <a href="<%= buy_link team.buy_url, content: "price-team" %>" class="btn btn-deep-outline btn-team" data-buy data-commerce
           data-fathom-event="<%= team.fathom_event %>"><%= team.buy_label %></a>
      </div>
    <% end %>
  </div>
</section>
