<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% resource_title = strip_html(strip_newlines(title)) %>
<% page_title = resource_title != "Index" ? "#{resource_title} | #{metadata.title}" : "#{metadata.title}: #{metadata.tagline}" %>
<title><%= page_title %></title>
<%# `social_title:` front matter replaces the title in link previews only
    (og:title, twitter:title); the browser tab keeps page_title. %>
<% social_title = (defined?(resource) && resource && resource.data.social_title) || page_title %>

<%
  # A sales or offer page's product data (Spec0031), or nil on any other page.
  sales = defined?(resource) && resource ? sales_data_for(resource) : nil

  # Per-page description, then the product's, then the site-level one.
  page_description = strip_newlines(
    (defined?(description) && description) || sales&.description || metadata.description
  )

  # Canonical and og:url are absolute and per-page. Only pretty URLs (which end
  # in a slash) are real pages; 404.html and 500.html must not claim to be one,
  # so they get neither tag.
  page_url = if defined?(resource) && resource && resource.relative_url.to_s.end_with?("/")
    absolute_url(resource.relative_url)
  end

  # Canonical and og:url diverge for a shared book or course whose canonical
  # page lives on the other site: `shared_content.rb` sets `canonical_url` to
  # that site's production URL, while og:url stays self-referential so a
  # shared card sends traffic to the page that was actually shared.
  # See Spec0009.
  canonical_url = page_url ? (resource.data.canonical_url || page_url) : nil

  # Per-page social image (Spec0031, A8): `image:` front matter, else a sales
  # or offer page's `og_image`, else the site card. Every one of them must be
  # 1200x630; the width/height tags below declare it.
  og_image_url = absolute_url(
    (defined?(resource) && resource && resource.data.image) || sales&.og_image || "/images/og-card.png"
  )
  og_type = defined?(resource) && resource && resource.collection&.label == "posts" ? "article" : "website"
%>

<meta name="description" content="<%= page_description %>" />
<%# `noindex: true` in front matter keeps any page out of search results.
    Offer pages always carry it (offers.rb); the welcome page sets it. %>
<% if defined?(resource) && resource && resource.data.noindex %>
<meta name="robots" content="noindex" />
<% end %>
<% if canonical_url %>
<link rel="canonical" href="<%= canonical_url %>" />
<% end %>

<meta property="og:title" content="<%= social_title %>" />
<meta property="og:description" content="<%= page_description %>" />
<meta property="og:type" content="<%= og_type %>" />
<% if page_url %>
<meta property="og:url" content="<%= page_url %>" />
<% end %>
<meta property="og:image" content="<%= og_image_url %>" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= social_title %>" />
<meta name="twitter:description" content="<%= page_description %>" />
<meta name="twitter:image" content="<%= og_image_url %>" />

<link rel="icon" type="image/png" href="<%= relative_url '/images/favicon.png' %>" />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
<!-- Fathom - beautiful, simple website analytics -->
