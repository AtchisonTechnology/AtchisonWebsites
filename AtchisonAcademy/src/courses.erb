---
layout: default
page_class: homepage
title: Courses
---

<section class="collection-hero">
  <div class="collection-hero-inner">
    <div class="courses-hero-content">
      <div>
        <span class="hero-eyebrow">Training &amp; Education</span>
        <h1>Courses at Atchison Academy</h1>
        <p>In-depth training on software architecture, cloud computing, and technology leadership, taught by Lee Atchison and delivered through Atchison Academy and its affiliated learning platforms. Every course page names the platform it is on and what getting in actually takes.</p>
      </div>
      <div class="courses-hero-badge">
        <img src="<%= relative_url '/images/learners-badge.png' %>" alt="Learners worldwide" />
      </div>
    </div>
  </div>
</section>

<%
  all_courses = site.collections["courses"].resources.sort_by { |c| c.data.order_academy || 99 }
  featured_courses  = all_courses.select { |c| c.data.feature_academy }
  remaining_courses = all_courses.reject { |c| c.data.feature_academy }
%>

<% unless featured_courses.empty? %>
<section class="featured-courses-section">
  <div class="section-inner">
    <div class="section-header">
      <span class="section-label">Featured</span>
      <h2 class="section-title">Featured Courses</h2>
    </div>
    <div class="courses-grid">
      <% featured_courses.each do |course| %>
        <a href="<%= relative_url course.relative_url %>" class="course-card course-card--featured">
          <% if course.data.cover_image %>
            <div class="course-cover-wrap">
              <img src="<%= relative_url course.data.cover_image %>"
                   alt="<%= course.data.title %> course image" class="course-cover" />
            </div>
          <% end %>
          <% if course.data.availability == "prelaunch" %>
            <span class="course-card-platform course-platform-badge--prelaunch">Coming Soon</span>
          <% else %>
            <span class="course-card-platform"><%= course.data.platform %></span>
          <% end %>
          <h3><%= course.data.title %></h3>
          <p><%= course.data.summary %></p>
          <span class="course-card-link">Learn more &rarr;</span>
        </a>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<section class="courses-grid-section">
  <div class="section-inner">
    <% unless featured_courses.empty? %>
      <div class="section-header">
        <span class="section-label">All Courses</span>
        <h2 class="section-title">More Courses</h2>
      </div>
    <% end %>
    <div class="courses-grid">
      <% remaining_courses.each do |course| %>
        <a href="<%= relative_url course.relative_url %>" class="course-card">
          <% if course.data.availability == "prelaunch" %>
            <span class="course-card-platform course-platform-badge--prelaunch">Coming Soon</span>
          <% else %>
            <span class="course-card-platform"><%= course.data.platform %></span>
          <% end %>
          <h3><%= course.data.title %></h3>
          <p><%= course.data.summary %></p>
          <span class="course-card-link">Learn more &rarr;</span>
        </a>
      <% end %>
    </div>
  </div>
</section>
