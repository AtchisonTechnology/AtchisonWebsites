<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% resource_title = strip_html(strip_newlines(title)) %>
<%# The home page (title "Home") and any "Index" page get "Lee Atchison: <tagline>" rather than "Home | Lee Atchison". %>
<% page_title = %w[Index Home].include?(resource_title) ? "#{metadata.title}: #{metadata.tagline}" : "#{resource_title} | #{metadata.title}" %>
<title><%= page_title %></title>

<%
  # Per-page description, falling back to the site-level one.
  page_description = strip_newlines(defined?(description) && description ? description : metadata.description)

  # Canonical and og:url are absolute and per-page. Only pretty URLs (which end
  # in a slash) are real pages; 404.html and 500.html must not claim to be one,
  # so they get neither tag.
  page_url = if defined?(resource) && resource && resource.relative_url.to_s.end_with?("/")
    absolute_url(resource.relative_url)
  end

  # Canonical and og:url diverge for a shared book or course whose canonical
  # page lives on the other site: `shared_content.rb` sets `canonical_url` to
  # that site's production URL, while og:url stays self-referential so a
  # shared card sends traffic to the page that was actually shared.
  # See Spec0009.
  canonical_url = page_url ? (resource.data.canonical_url || page_url) : nil

  og_image_url = absolute_url("/images/og-card.png")
  og_type = defined?(resource) && resource && resource.collection&.label == "posts" ? "article" : "website"
%>

<meta name="description" content="<%= page_description %>" />
<% if canonical_url %>
<link rel="canonical" href="<%= canonical_url %>" />
<% end %>

<meta property="og:title" content="<%= page_title %>" />
<meta property="og:description" content="<%= page_description %>" />
<meta property="og:type" content="<%= og_type %>" />
<% if page_url %>
<meta property="og:url" content="<%= page_url %>" />
<% end %>
<meta property="og:image" content="<%= og_image_url %>" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= page_title %>" />
<meta name="twitter:description" content="<%= page_description %>" />
<meta name="twitter:image" content="<%= og_image_url %>" />

<%
  # Master Person record (Spec0034). Every other site's structured data points
  # at this @id, so search engines and AI crawlers see one Lee Atchison behind
  # all of it. Emitted on the home and about pages only.
  if defined?(resource) && resource && ["/", "/about/"].include?(resource.relative_url.to_s)
    person_ld = {
      "@context" => "https://schema.org",
      "@type" => "Person",
      "@id" => "https://leeatchison.com/#person",
      "name" => "Lee Atchison",
      "url" => "https://leeatchison.com/",
      "image" => absolute_url("/images/lee-atchison.png"),
      "jobTitle" => "Software Architect",
      "description" => "Lee Atchison is a software architect and author who helps companies architect and operate AI-powered SaaS at scale.",
      "worksFor" => { "@type" => "Organization", "name" => "Atchison Technology" },
      "knowsAbout" => [
        "Architecting AI-powered SaaS at scale",
        "AI cost architecture",
        "Operating AI reliably in production",
        "Scalability and high availability"
      ],
      "sameAs" => [
        "https://www.linkedin.com/in/leeatchison",
        "https://github.com/leeatchison",
        "https://x.com/leeatchison",
        "https://www.threads.com/@leeatchison",
        "https://www.amazon.com/author/leeatchison",
        "https://softwarearchitectureinsights.com/",
        "https://atchisonacademy.com/",
        "https://thesoftwareconductor.com/",
        "https://architectingforscale.com/",
        "https://stosa.org/"
      ]
    }
%>
<script type="application/ld+json"><%== JSON.pretty_generate(person_ld) %></script>
<% end %>

<link rel="icon" type="image/png" href="<%= relative_url '/images/favicon.png' %>" />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
