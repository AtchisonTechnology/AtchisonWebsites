---
layout: default
title: Articles
permalink: /posts/
pagination:
  enabled: true
  collection: articles
  per_page: 12
  permalink: "page/:num/"
---

<h1>All Articles</h1>

<ul class="article-list">
  <% paginator.documents.each do |article| %>
    <li class="article-list-item">
      <% if article.data.hero_image %>
        <img src="<%= relative_url "/images/posts/#{article.data.hero_image}" %>" alt="" class="article-list-thumb" />
      <% end %>
      <div class="article-list-meta">
        <% Array(article.data.categories).each do |label| %>
          <% cat = site.data.categories.find { |c| c["label"] == label } %>
          <% next unless cat %>
          <a href="<%= relative_url "/categories/#{cat['key']}/" %>" class="article-list-category"><%= cat["label"] %></a>
        <% end %>
        <% if article.data.date %>
          <time class="article-list-date" datetime="<%= article.data.date.strftime('%Y-%m-%d') %>"><%= article.data.date.strftime('%B %-d, %Y') %></time>
        <% end %>
      </div>
      <a href="<%= relative_url article.relative_url %>" class="article-list-title"><%= article.data.title %></a>
      <p class="article-list-description"><%= article.data.description %></p>
      <a href="<%= relative_url article.relative_url %>" class="article-list-readmore">Read more &rarr;</a>
    </li>
  <% end %>
</ul>

<nav class="pagination" aria-label="Article pages">
  <% if paginator.previous_page_path %>
    <a href="<%= relative_url paginator.previous_page_path %>">&larr; Newer</a>
  <% end %>
  <span>Page <%= paginator.page %> of <%= paginator.total_pages %></span>
  <% if paginator.next_page_path %>
    <a href="<%= relative_url paginator.next_page_path %>">Older &rarr;</a>
  <% end %>
</nav>
