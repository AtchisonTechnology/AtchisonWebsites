<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% resource_title = strip_html(strip_newlines(title)) %>
<% page_title = resource_title != "Index" ? "#{resource_title} | #{metadata.title}" : "#{metadata.title}: #{metadata.tagline}" %>
<title><%= page_title %></title>

<%
  page_description = strip_newlines(defined?(description) && description ? description : metadata.description)

  page_url = if defined?(resource) && resource && resource.relative_url.to_s.end_with?("/")
    absolute_url(resource.relative_url)
  end

  canonical_url = page_url

  is_article = defined?(resource) && resource && resource.respond_to?(:collection) &&
    resource.collection&.label == "articles"
  og_type = is_article ? "article" : "website"

  # /podcast/ and every episode page share the show art as their
  # social-share image (Spec0027) — covers both without needing to special-
  # case the episodes collection vs. the plain /podcast/ page separately.
  is_podcast_page = defined?(resource) && resource && resource.relative_url.to_s.start_with?("/podcast/")

  og_image_url = if is_article && resource.data.hero_image
    absolute_url("/images/posts/#{resource.data.hero_image}")
  elsif is_podcast_page
    absolute_url("/images/podcast/show-art.png")
  else
    absolute_url("/images/og-card.png")
  end
%>

<meta name="description" content="<%= page_description %>" />
<% if canonical_url %>
<link rel="canonical" href="<%= canonical_url %>" />
<% end %>
<% if defined?(resource) && resource && resource.data.noindex %>
<meta name="robots" content="noindex" />
<% end %>

<meta property="og:title" content="<%= page_title %>" />
<meta property="og:description" content="<%= page_description %>" />
<meta property="og:type" content="<%= og_type %>" />
<% if page_url %>
<meta property="og:url" content="<%= page_url %>" />
<% end %>
<meta property="og:image" content="<%= og_image_url %>" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= page_title %>" />
<meta name="twitter:description" content="<%= page_description %>" />
<meta name="twitter:image" content="<%= og_image_url %>" />

<%
  # Structured data (Spec0034). Lee's master Person record lives on
  # leeatchison.com under the @id below; this site points at it rather than
  # redefining him, so search engines and AI crawlers see one Lee Atchison.
  lee_ref = {
    "@id" => "https://leeatchison.com/#person",
    "name" => "Lee Atchison",
    "url" => "https://leeatchison.com/"
  }
  json_ld = if is_article
    published = resource.data.published_on || resource.data.date
    modified = resource.data.updated || resource.data.date_modified
    {
      "@context" => "https://schema.org",
      "@type" => "Article",
      "headline" => strip_html(strip_newlines(resource.data.title)),
      "datePublished" => published&.strftime("%Y-%m-%d"),
      "dateModified" => modified&.strftime("%Y-%m-%d"),
      "url" => page_url,
      "image" => og_image_url,
      "author" => { "@type" => "Person" }.merge(lee_ref),
      "publisher" => {
        "@type" => "Organization",
        "name" => "Software Architecture Insights",
        "url" => "https://softwarearchitectureinsights.com/",
        "logo" => absolute_url("/images/brand/sai-nav-mark.png")
      }
    }.compact
  elsif defined?(resource) && resource && resource.relative_url.to_s == "/about/"
    {
      "@context" => "https://schema.org",
      "@type" => "Person",
      **lee_ref,
      "description" => "Lee Atchison is a software architect and author who helps companies architect and operate AI-powered SaaS at scale.",
      "sameAs" => [
        "https://www.linkedin.com/in/leeatchison",
        "https://github.com/leeatchison",
        "https://x.com/leeatchison",
        "https://www.threads.com/@leeatchison",
        "https://www.amazon.com/author/leeatchison",
        "https://softwarearchitectureinsights.com/",
        "https://atchisonacademy.com/",
        "https://thesoftwareconductor.com/",
        "https://architectingforscale.com/",
        "https://stosa.org/"
      ]
    }
  end
%>
<% if json_ld %>
<script type="application/ld+json"><%== JSON.pretty_generate(json_ld) %></script>
<% end %>

<link rel="icon" href="<%= relative_url '/favicon.ico' %>" />
<link rel="icon" type="image/png" sizes="32x32" href="<%= relative_url '/favicon-32x32.png' %>" />
<link rel="apple-touch-icon" href="<%= relative_url '/apple-touch-icon.png' %>" />

<link rel="alternate" type="application/atom+xml" title="<%= metadata.title %>" href="<%= relative_url '/feed.xml' %>" />

<link rel="preload" href="<%= relative_url '/fonts/lora-latin-700.woff2' %>" as="font" type="font/woff2" crossorigin />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
<% if site.metadata.fathom_site_id.to_s != "" %>
<!-- Fathom - beautiful, simple website analytics -->
<script src="https://cdn.usefathom.com/script.js" data-site="<%= site.metadata.fathom_site_id %>" defer></script>
<!-- / Fathom -->
<% end %>
