<%
  # The Cascadras "Reserve a founding seat" form (WEB-32), for
  # /free/cascadras/. Our own HTML, posting straight to one Kit form's
  # subscribe endpoint, because Kit's form builder only does text fields.
  # Each answer goes into the matching Kit custom field, `fields[<key>]`. A
  # Kit rule adds the tags Cascadras and no-auto-sai, so signups never join
  # the SAI list and the page sends no tags.
  #
  # It is the same form, field for field, as the one on cascadras.com
  # (Cascadras/src/_partials/_reserve_form.erb). Keep the two in step.
  #
  # It uses the free-signup script in frontend/javascript/index.js: a good
  # submit fires the Fathom event cascadras-signup, hides the fields and
  # shows the thank-you panel in place.
  #
  # Locals:
  #   form_id   Kit form ID (number)
%>
<form class="free-signup cascadras-form" action="https://app.kit.com/forms/<%= form_id %>/subscriptions" method="post"
      data-free-signup data-fathom-event="cascadras-signup">
  <div class="free-signup-fields">
    <div class="cascadras-field">
      <label for="cascadras-name">Name</label>
      <input id="cascadras-name" type="text" name="fields[first_name]" autocomplete="name" required />
    </div>
    <div class="cascadras-field">
      <label for="cascadras-email">Email</label>
      <input id="cascadras-email" type="email" name="email_address" autocomplete="email" required />
    </div>
    <div class="cascadras-field">
      <label for="cascadras-role">Your role</label>
      <select id="cascadras-role" name="fields[cascadras_role]">
        <option value="">Choose one</option>
        <option>Architect</option>
        <option>Engineering manager</option>
        <option>Other</option>
      </select>
    </div>
    <div class="cascadras-field">
      <label for="cascadras-team-size">Team size (engineers)</label>
      <select id="cascadras-team-size" name="fields[cascadras_team_size]">
        <option value="">Choose one</option>
        <option>Under 10</option>
        <option>10–25</option>
        <option>26–50</option>
        <option>Over 50</option>
      </select>
    </div>
    <div class="cascadras-field">
      <label for="cascadras-decisions">How does your team keep architecture decisions today?</label>
      <input id="cascadras-decisions" type="text" name="fields[cascadras_decisions_today]" />
    </div>
    <div class="cascadras-field">
      <label for="cascadras-risk">How does your team track risk today?</label>
      <input id="cascadras-risk" type="text" name="fields[cascadras_risk_today]" />
    </div>
    <fieldset class="cascadras-field cascadras-choice">
      <legend>May we call you for 30 minutes about how your team works?</legend>
      <label><input type="radio" name="fields[cascadras_call_ok]" value="Yes" /> Yes</label>
      <label><input type="radio" name="fields[cascadras_call_ok]" value="No" /> No</label>
    </fieldset>

    <button class="free-signup-button" type="submit">Reserve a founding seat</button>
    <p class="free-signup-status" role="status" aria-live="polite"></p>
    <p class="free-signup-disclaimer"><em>We'll use your email only for news about Cascadras and, if you said yes, to set up a call. Nothing else.</em></p>
  </div>

  <div class="cascadras-thanks" data-success-panel hidden tabindex="-1">
    <p><strong>Your founding seat is reserved.</strong> We'll be in touch if Cascadras launches. If you said yes to a call, Lee may email you to set one up.</p>
  </div>
</form>
