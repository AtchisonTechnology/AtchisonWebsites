---
layout: default
page_class: homepage
title: Index
description: >-
  Software Architecture Insights is Lee Atchison's weekly newsletter on
  software architecture, cloud computing, and building systems that scale.
---

<section class="home-hero">
  <img
    src="<%= relative_url '/images/brand/sai-banner-conductor.svg' %>"
    alt="<%= site.metadata.title %> with Lee Atchison"
    class="home-hero-banner"
  />
  <h1 class="sr-only"><%= site.metadata.title %></h1>
  <p class="home-tagline"><%= site.metadata.tagline %></p>
  <div class="home-subscribe">
    <%= render "kit_form", uid: site.metadata.kit_inline_form_uid %>
  </div>
  <p class="home-subscriber-count">Join <%= site.metadata.subscriber_count %> architects &amp; engineering leaders</p>
</section>

<section class="home-categories">
  <h2>Browse by topic</h2>
  <ul class="category-shelf">
    <% site.data.categories.each do |category| %>
      <li><a href="<%= relative_url "/categories/#{category['key']}/" %>"><%= category["label"] %></a></li>
    <% end %>
  </ul>
</section>

<section class="home-latest">
  <h2>Latest articles</h2>

  <% latest = site.collections.articles.resources.first(9)
     featured = latest.first
     rest = latest.drop(1) %>

  <% if featured %>
    <a href="<%= relative_url featured.relative_url %>" class="featured-article">
      <% if featured.data.hero_image %>
        <img src="<%= relative_url "/images/posts/#{featured.data.hero_image}" %>" alt="" class="featured-article-thumb" />
      <% end %>
      <div class="featured-article-body">
        <span class="featured-article-label">Latest</span>
        <div class="article-list-meta">
          <% Array(featured.data.categories).each do |label| %>
            <% cat = site.data.categories.find { |c| c["label"] == label } %>
            <% next unless cat %>
            <span class="article-list-category"><%= cat["label"] %></span>
          <% end %>
          <% if featured.data.date %>
            <time class="article-list-date" datetime="<%= featured.data.date.strftime('%Y-%m-%d') %>"><%= featured.data.date.strftime('%B %-d, %Y') %></time>
          <% end %>
        </div>
        <h3 class="featured-article-title"><%= featured.data.title %></h3>
        <p class="featured-article-description"><%= featured.data.description %></p>
      </div>
    </a>
  <% end %>

  <ul class="article-list">
    <% rest.each do |article| %>
      <li class="article-list-item">
        <% if article.data.hero_image %>
          <img src="<%= relative_url "/images/posts/#{article.data.hero_image}" %>" alt="" class="article-list-thumb" />
        <% end %>
        <div class="article-list-meta">
          <% Array(article.data.categories).each do |label| %>
            <% cat = site.data.categories.find { |c| c["label"] == label } %>
            <% next unless cat %>
            <a href="<%= relative_url "/categories/#{cat['key']}/" %>" class="article-list-category"><%= cat["label"] %></a>
          <% end %>
          <% if article.data.date %>
            <time class="article-list-date" datetime="<%= article.data.date.strftime('%Y-%m-%d') %>"><%= article.data.date.strftime('%B %-d, %Y') %></time>
          <% end %>
        </div>
        <a href="<%= relative_url article.relative_url %>" class="article-list-title"><%= article.data.title %></a>
        <p class="article-list-description"><%= article.data.description %></p>
        <a href="<%= relative_url article.relative_url %>" class="article-list-readmore">Read more &rarr;</a>
      </li>
    <% end %>
  </ul>
  <p><a href="<%= relative_url '/posts' %>">All articles &rarr;</a></p>
</section>
